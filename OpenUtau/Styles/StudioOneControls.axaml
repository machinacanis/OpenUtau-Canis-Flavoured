<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Studio One style button skin (Studio UI only: loaded through StudioStyles.axaml).

    Any Button or ToggleButton in the app opts in with the `s1` class:

      <ToggleButton Classes="s1 mute" .../>   checked = red     (mute)
      <ToggleButton Classes="s1 solo" .../>   checked = amber   (solo)
      <Button       Classes="s1 fx"   .../>   fxOn class = theme accent (non-toggle)
      <ToggleButton Classes="s1"      .../>   checked = theme accent (no role)

    Add a role by adding one `^:checked.<role> /template/ Border#PART_Chrome` style
    to the ToggleButton rule below. Spacing (Margin) stays at the call site.

    The chrome lives inside the template instead of the control's Background /
    BorderBrush: control-level styles (e.g. TrackHeader.axaml's
    `ToggleButton { Background: Transparent }`) outrank application styles, so
    property setters here would be swallowed. Template-owned chrome cannot be.

    ToggleButton rules must stay after Button rules: a ToggleButton is a Button,
    so both match and the later Template setter wins.
  -->
  <Style Selector="Button.s1">
    <Setter Property="Height" Value="18"/>
    <Setter Property="MinWidth" Value="18"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_Chrome" BorderThickness="1" CornerRadius="3">
          <ContentPresenter x:Name="PART_Content"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^ /template/ Border#PART_Chrome">
      <Setter Property="Background" Value="{DynamicResource NeutralAccentBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource NeutralAccentBrushPointerOver}"/>
    </Style>
    <Style Selector="^:pointerover /template/ Border#PART_Chrome">
      <Setter Property="Background" Value="{DynamicResource NeutralAccentBrushPointerOver}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightBaseMediumHighBrush}"/>
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_Chrome">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrushPointerOver}"/>
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Chrome">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush2}"/>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.5"/>
    </Style>
    <!-- Non-toggle "on" state, driven by the consumer's own class. -->
    <Style Selector="^.fxOn /template/ Border#PART_Chrome">
      <Setter Property="Background" Value="{DynamicResource AccentBrush2}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush2Semi}"/>
    </Style>
    <Style Selector="^.fxOn">
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrushPointerOver}"/>
    </Style>
    <Style Selector="^ Path.filled">
      <Setter Property="Fill" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
    </Style>
  </Style>

  <Style Selector="ToggleButton.s1">
    <Setter Property="Height" Value="18"/>
    <Setter Property="MinWidth" Value="18"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_Chrome" BorderThickness="1" CornerRadius="3">
          <ContentPresenter x:Name="PART_Content"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^ /template/ Border#PART_Chrome">
      <Setter Property="Background" Value="{DynamicResource NeutralAccentBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource NeutralAccentBrushPointerOver}"/>
    </Style>
    <Style Selector="^:pointerover /template/ Border#PART_Chrome">
      <Setter Property="Background" Value="{DynamicResource NeutralAccentBrushPointerOver}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightBaseMediumHighBrush}"/>
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_Chrome">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrushPointerOver}"/>
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Chrome">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush2}"/>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.5"/>
    </Style>
    <Style Selector="^ Path.filled">
      <Setter Property="Fill" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
    </Style>
    <!-- Checked: theme accent by default, role classes override below. -->
    <Style Selector="^:checked /template/ Border#PART_Chrome">
      <Setter Property="Background" Value="{DynamicResource AccentBrush2}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush2Semi}"/>
    </Style>
    <Style Selector="^:checked Path.filled">
      <Setter Property="Fill" Value="{DynamicResource SystemControlForegroundBaseHighBrushPointerOver}"/>
    </Style>
    <Style Selector="^:checked.mute /template/ Border#PART_Chrome">
      <Setter Property="Background" Value="{DynamicResource TrackMuteBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource TrackMuteBorderBrush}"/>
    </Style>
    <Style Selector="^:checked.mute:pointerover /template/ Border#PART_Chrome">
      <Setter Property="Background" Value="{DynamicResource TrackMuteBorderBrush}"/>
    </Style>
    <Style Selector="^:checked.mute Path.filled">
      <Setter Property="Fill" Value="{DynamicResource OnTrackMuteBrush}"/>
    </Style>
    <Style Selector="^:checked.solo /template/ Border#PART_Chrome">
      <Setter Property="Background" Value="{DynamicResource TrackSoloBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource TrackSoloBorderBrush}"/>
    </Style>
    <Style Selector="^:checked.solo:pointerover /template/ Border#PART_Chrome">
      <Setter Property="Background" Value="{DynamicResource TrackSoloBorderBrush}"/>
    </Style>
    <Style Selector="^:checked.solo Path.filled">
      <Setter Property="Fill" Value="{DynamicResource OnTrackSoloBrush}"/>
    </Style>
  </Style>
</Styles>
