<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:OpenUtau.App.ViewModels"
             xmlns:c="using:OpenUtau.App.Controls"
             x:Class="OpenUtau.App.Controls.NotePropertyExpression"
             x:DataType="vm:NotePropertyExpViewModel">
  <Grid ColumnDefinitions="143,7,*">
    <Label Content="{Binding Name}" Grid.Column="0" VerticalAlignment="Center" FontWeight="{Binding NameFontWeight}"/>
    <c:UnboundedSlider Name="slider" Grid.Column="2" Value="{Binding Value}" Minimum="{Binding Min}" Maximum="{Binding Max}"
                       TickFrequency="1" IsVisible="{Binding IsNumerical}" VerticalAlignment="Center" IsEnabled="{Binding IsNoteSelected}"/>
    <ComboBox Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding Options}"
              SelectedIndex="{Binding SelectedOption}" MinWidth="120" IsVisible="{Binding IsOptions}" VerticalAlignment="Center" IsEnabled="{Binding IsNoteSelected}"
              IsDropDownOpen="{Binding DropDownOpen, Mode=OneWayToSource}"
              Name="comboBox"/>
  </Grid>
</UserControl>
